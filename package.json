{
  "name": "officina",
  "private": true,
  "version": "0.1.0",
  "description": "An index of open-source tools by Anton Soloviev.",
  "author": "Anton Soloviev",
  "license": "MIT",
  "homepage": "https://antonsoo.github.io/officina/",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/officina"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
